[Unit]
Description=Mower V2 Web Bridge Service
After=network.target redis.service mower-v2-manual.service
Requires=redis.service
PartOf=mower-v2.target

[Service]
Type=exec
User=root
Group=root
WorkingDirectory=/home/pi/autonomous_mower
Environment=PYTHONPATH=/home/pi/autonomous_mower
Environment=MOWER_LOG_LEVEL=INFO
ExecStart=/usr/bin/python3 /home/pi/autonomous_mower/mower_v2/launcher.py web-bridge
Restart=always
RestartSec=5
KillMode=mixed
TimeoutStopSec=30

[Install]
WantedBy=mower-v2.target
